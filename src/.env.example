# ── Anthropic ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=                        # required (unless GEMINI_API_KEY is set)

# ── Google Gemini (fallback) ───────────────────────────────────────────────────
# Optional. When set alongside ANTHROPIC_API_KEY, the agent auto-falls-back to
# Gemini 2.5 Flash if the Anthropic call fails (credit exhaustion / outage).
# Free tier on Google AI Studio: aistudio.google.com → "Get API key".
GEMINI_API_KEY=

# ── Gmail OAuth ────────────────────────────────────────────────────────────────
# Required in any containerised/cloud deployment (no credentials.json / token.json on disk).
# In local dev only, these can be omitted and the agent falls back to token.json.
# To get values: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# ── Google Pub/Sub ─────────────────────────────────────────────────────────────
PUBSUB_TOPIC_NAME=projects/<gcp-project>/topics/gmail-push
PUBSUB_VERIFICATION_TOKEN=                # secret appended to push URL as ?token=

# ── Scheduled tasks ────────────────────────────────────────────────────────────
# Keep false in local dev so a dev process never registers/renews the Gmail watch
# or sends a digest that collides with production. Production sets this to true.
ENABLE_CRONS=false

# ── Agent behaviour ────────────────────────────────────────────────────────────
TRUST_PHASE=label                         # shadow | label | archive | draft (code default: label)
DIGEST_TO_EMAIL=                          # recipient for both the daily digest and the quick digest

# ── Dashboard auth ─────────────────────────────────────────────────────────────
# HTTP Basic Auth for the dashboard (mounted into the public webapp). Leave
# DASHBOARD_PASSWORD blank locally to keep the dashboard open; set it in any
# deployment (the webhook + /health stay open regardless).
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# ── Stats ──────────────────────────────────────────────────────────────────────
# Optional — defaults to src/stats.db. Set to an absolute path on a persistent volume
# when running in a container, or leave unset to migrate to Postgres later.
STATS_DB_PATH=

# ── LangSmith tracing (optional) ───────────────────────────────────────────────
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_TRACING=
LANGSMITH_ENDPOINT=
